# ---------------------------------------------------------------------------
# EcoMotion Frontend — mẫu cấu hình môi trường
# Copy file này thành `.env` rồi chỉnh theo máy của bạn:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Base path của backend API. Mọi request từ `apiClient` đi qua tiền tố này,
# và Vite dev proxy sẽ forward sang VITE_API_TARGET (xem vite.config.js).
VITE_API_BASE_URL=/api

# Địa chỉ gốc của Spring Boot backend dùng cho dev proxy.
# Đổi port/host ở đây nếu backend không chạy ở 8080.
VITE_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# reCAPTCHA v3 (invisible) — site key là PUBLIC (nhúng vào bundle), an toàn để commit.
# Secret key KHÔNG được đặt ở đây; nó thuộc backend qua biến môi trường RECAPTCHA_SECRET_KEY.
#
# Lấy cặp khoá tại https://www.google.com/recaptcha/admin (chọn loại "Score based (v3)").
# Để TRỐNG biến này => frontend tự tắt reCAPTCHA (gửi captchaToken rỗng). Hữu ích khi
# backend đang chạy với app.captcha.enabled=false.
# ---------------------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=
